{
  "compilerOptions": {
    "paths": { "obsidian": ["./node_modules/obsidian"] },
    "typeRoots": ["node_modules/@types", "node_modules/obsidian"],
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "allowJs": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "downlevelIteration": false,
    "esModuleInterop": true,
    "lib": ["dom", "es2022"]
  },
  "include": ["src/**/*.ts"]
}